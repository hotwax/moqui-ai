<?xml version="1.0" encoding="UTF-8"?>
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <default-property name="ai_anthropic_key" value="" is-secret="true"/>
    <default-property name="ai_anthropic_base_url" value="https://api.anthropic.com"/>
    <default-property name="ai_anthropic_version" value="2023-06-01"/>
    <default-property name="ai_openai_key" value="" is-secret="true"/>
    <default-property name="ai_openai_base_url" value="https://api.openai.com/v1"/>
    <default-property name="ai_timeout_seconds" value="60"/>
    <!-- Default LLM for newly DRAFTED agents (the Composer's draft_agent / store#AiAgent on create).
         The user describes WHAT an agent does; the system picks the model. Override per deployment. -->
    <default-property name="ai_default_provider" value="openai"/>
    <default-property name="ai_default_model" value="gpt-4o-mini"/>
    <default-property name="ai_knowledge_max_chars" value="24000"/>
    <!-- MCP endpoint: dark by default — serving MCP is a deliberate, per-deployment decision.
         Until a deployment sets mcp_enabled=Y the endpoint answers 404 to everything. -->
    <default-property name="mcp_enabled" value="N"/>
    <!-- MCP tool catalog cache: declared like the framework's service.rest.api cache (no expire
         attributes = no expiry); rebuilt on any cache miss by ai.mcp.McpServices.get#ToolCatalog -->
    <cache-list>
        <cache name="ai.mcp.tool.catalog" value-type="java.util.List"/>
    </cache-list>
    <tools>
        <tool-factory class="org.moqui.ai.AiToolFactory" init-priority="30" disabled="false"/>
    </tools>
    <!-- Mount the AI Ops console as a top-level app under the standard apps webapp.
         Same mechanism the tools/oms/poorti components use (subscreens-item on apps.xml);
         lives in this component's own MoquiConf so no webroot file is touched. URL: /apps/AiOps -->
    <screen-facade>
        <screen location="component://webroot/screen/webroot/apps.xml">
            <subscreens-item name="AiOps" menu-title="AI Ops" menu-index="97" location="component://moqui-ai/screen/AiOps.xml"/>
        </screen>
        <!-- MCP endpoint at /mcp/json — mounted on webroot itself (like /rest and /rpc), not under
             an app. Transport screen only; behavior is in ai.mcp.McpServices.dispatch#Request. -->
        <screen location="component://webroot/screen/webroot.xml">
            <subscreens-item name="mcp" location="component://moqui-ai/screen/Mcp.xml"/>
        </screen>
    </screen-facade>
</moqui-conf>
