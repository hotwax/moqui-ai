<?xml version="1.0" encoding="UTF-8"?>
<!-- MCP endpoint rate limiting (spec: docs/specs/2026-08-23-mcp-server-design.md, design
     decision 11): Moqui's ArtifactTarpit over the one service every MCP request passes
     through, ai.mcp.McpServices.dispatch#Request. Because the tarpit counter is per user
     per artifact, capping dispatch is a TOTAL per-caller cap on the endpoint — this closes
     the per-service-counter gap noted in the spec. All anonymous callers share one bucket
     (no userId), which only ever carries discover/list traffic.
     Limit: 120 hits per 60s per caller, locked out for 60s (429 with Retry-After via
     MoquiServlet). Override per deployment by loading a row with different numbers. -->
<entity-facade-xml type="ext-seed" sequence="6">
    <moqui.security.ArtifactGroup artifactGroupId="MCP_DISPATCH" description="MCP endpoint dispatch service (rate limiting)"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MCP_DISPATCH" artifactTypeEnumId="AT_SERVICE"
            artifactName="ai.mcp.McpServices.dispatch#Request" nameIsPattern="N" inheritAuthz="Y"/>
    <!-- Added so an ADMIN-group MCP caller isn't blocked by a narrowly-authorized nested artifact (e.g. SystemMessageServices.queue#SystemMessage); TODO: define ArtifactAuthz per artifact exposed via an MCP tool instead of this group-level allow. -->
    <moqui.security.ArtifactAuthz artifactAuthzId="McpServicesADMIN" userGroupId="ADMIN" artifactGroupId="MCP_DISPATCH" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>
    <moqui.security.ArtifactTarpit userGroupId="ALL_USERS" artifactGroupId="MCP_DISPATCH"
            maxHitsCount="120" maxHitsDuration="60" tarpitDuration="60"/>
</entity-facade-xml>
