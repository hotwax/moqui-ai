<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="FactType" package="moqui.ai" use="configuration" cache="true">
        <description>One kind of fact that rules read, like checkResult or salesOrder.</description>
        <field name="factTypeId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <relationship type="many" related="moqui.ai.FactField" short-alias="fields"><key-map field-name="factTypeId"/></relationship>
        <relationship type="many" related="moqui.ai.FactNode" short-alias="nodes"><key-map field-name="factTypeId"/></relationship>
        <master>
            <detail relationship="fields"/>
            <detail relationship="nodes"><detail relationship="conditions"/></detail>
        </master>
    </entity>

    <entity entity-name="FactField" package="moqui.ai" use="configuration" cache="true">
        <description>One value in a fact, with its type. Rules are checked against these fields.</description>
        <field name="factTypeId" type="id" is-pk="true"/>
        <field name="fieldName" type="id" is-pk="true"/>
        <field name="valueTypeEnumId" type="id"/>
        <field name="itemFactTypeId" type="id"><description>For a list field, the fact type of each item.</description></field>
        <field name="description" type="text-medium"/>
        <relationship type="one" related="moqui.ai.FactType"/>
        <relationship type="one" title="FactValueType" related="moqui.basic.Enumeration" short-alias="valueType">
            <key-map field-name="valueTypeEnumId" related="enumId"/></relationship>
        <relationship type="one" title="Item" related="moqui.ai.FactType" short-alias="itemFactType">
            <key-map field-name="itemFactTypeId" related="factTypeId"/></relationship>
    </entity>

    <entity entity-name="FactNode" package="moqui.ai" use="configuration" cache="true">
        <description>One step of the tree that builds a fact from entity data.</description>
        <field name="factTypeId" type="id" is-pk="true"/>
        <field name="nodeSeqId" type="id" is-pk="true"/>
        <field name="parentNodeSeqId" type="id"/>
        <field name="sequenceNum" type="number-integer"/>
        <field name="nodeTypeEnumId" type="id"/>
        <field name="fieldName" type="id"><description>The fact field this node fills. Empty for a record node.</description></field>
        <field name="entityName" type="text-medium"><description>The entity a top record, list or count node reads.</description></field>
        <field name="relationshipName" type="text-medium"><description>The relationship of the parent row that a child record, list or count node follows.</description></field>
        <field name="entityFieldName" type="text-short"><description>The parent row field a value node reads.</description></field>
        <field name="fixedValue" type="text-medium"/>
        <field name="parameterName" type="text-short"><description>The caller value a value node reads.</description></field>
        <field name="filterByDate" type="text-indicator"><description>Y makes a record, list or count node read only the rows
            current now: fromDate empty or not after now, and thruDate empty or after now.</description></field>
        <relationship type="one" related="moqui.ai.FactType"/>
        <relationship type="one" title="Parent" related="moqui.ai.FactNode" short-alias="parent">
            <key-map field-name="factTypeId"/><key-map field-name="parentNodeSeqId" related="nodeSeqId"/></relationship>
        <relationship type="one" related="moqui.ai.FactField" short-alias="field">
            <key-map field-name="factTypeId"/><key-map field-name="fieldName"/></relationship>
        <relationship type="one" title="FactNodeType" related="moqui.basic.Enumeration" short-alias="nodeType">
            <key-map field-name="nodeTypeEnumId" related="enumId"/></relationship>
        <relationship type="many" related="moqui.ai.FactNodeCondition" short-alias="conditions">
            <key-map field-name="factTypeId"/><key-map field-name="nodeSeqId"/></relationship>
    </entity>

    <entity entity-name="FactNodeCondition" package="moqui.ai" use="configuration" cache="true">
        <description>Says which rows a record, list or count node reads.</description>
        <field name="factTypeId" type="id" is-pk="true"/>
        <field name="nodeSeqId" type="id" is-pk="true"/>
        <field name="conditionSeqId" type="id" is-pk="true"/>
        <field name="entityFieldName" type="text-short"/>
        <field name="operatorEnumId" type="id"/>
        <field name="fixedValue" type="text-medium"/>
        <field name="parameterName" type="text-short"><description>The caller value to compare with. Used when fixedValue is empty.</description></field>
        <relationship type="one" related="moqui.ai.FactNode">
            <key-map field-name="factTypeId"/><key-map field-name="nodeSeqId"/></relationship>
        <relationship type="one" title="ComparisonOperator" related="moqui.basic.Enumeration" short-alias="operator">
            <key-map field-name="operatorEnumId" related="enumId"/></relationship>
    </entity>

    <entity entity-name="RuleSet" package="moqui.ai" use="configuration">
        <description>One decision, like SWITCH_ON_A_JOB.</description>
        <field name="ruleSetId" type="id" is-pk="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
        <field name="firstMatchOnly" type="text-indicator" enable-audit-log="true"><description>Y returns only the outcome of the highest priority rule that matches.</description></field>
        <relationship type="many" related="moqui.ai.RuleSetFactType" short-alias="factTypes"><key-map field-name="ruleSetId"/></relationship>
        <relationship type="many" related="moqui.ai.RuleSetOutcome" short-alias="outcomes"><key-map field-name="ruleSetId"/></relationship>
        <relationship type="many" related="moqui.ai.RuleSetRule" short-alias="rules"><key-map field-name="ruleSetId"/></relationship>
    </entity>

    <entity entity-name="RuleSetFactType" package="moqui.ai" use="configuration">
        <description>A fact type a decision reads.</description>
        <field name="ruleSetId" type="id" is-pk="true"/>
        <field name="factTypeId" type="id" is-pk="true"/>
        <relationship type="one" related="moqui.ai.RuleSet"/>
        <relationship type="one" related="moqui.ai.FactType"/>
    </entity>

    <entity entity-name="RuleSetOutcome" package="moqui.ai" use="configuration">
        <description>One result in the fixed list a decision can give.</description>
        <field name="ruleSetId" type="id" is-pk="true"/>
        <field name="outcomeId" type="id" is-pk="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="moqui.ai.RuleSet"/>
    </entity>

    <entity entity-name="RuleSetRule" package="moqui.ai" use="configuration">
        <description>One rule of a decision. A change edits it in place; the entity audit log keeps the old values.</description>
        <field name="ruleId" type="id" is-pk="true"/>
        <field name="ruleSetId" type="id" enable-audit-log="true"/>
        <field name="ruleName" type="text-short" enable-audit-log="true"/>
        <field name="priority" type="number-integer" enable-audit-log="true"/>
        <field name="description" type="text-medium" enable-audit-log="true"/>
        <field name="changedDate" type="date-time" enable-audit-log="true"><description>When store#Rule last recorded a change to the rule or its lines.</description></field>
        <relationship type="one" related="moqui.ai.RuleSet"/>
        <relationship type="many" related="moqui.ai.RuleSetCondition" short-alias="conditions"><key-map field-name="ruleId"/></relationship>
        <relationship type="many" related="moqui.ai.RuleSetAction" short-alias="actions"><key-map field-name="ruleId"/></relationship>
        <index name="RULE_SET_RULE_NAME" unique="true"><index-field name="ruleSetId"/><index-field name="ruleName"/></index>
        <index name="RULE_SET_RULE_PRIORITY" unique="true"><index-field name="ruleSetId"/><index-field name="priority"/></index>
        <master>
            <detail relationship="conditions"><detail relationship="conditionType"/></detail>
            <detail relationship="actions"><detail relationship="actionType"/><detail relationship="fields"/></detail>
        </master>
    </entity>

    <entity entity-name="RuleConditionType" package="moqui.ai" use="configuration" cache="true">
        <description>One kind of "when" line, like compare a field or all lines match, with the service that checks a line of
            this kind and turns it into a Moqui condition.</description>
        <field name="conditionTypeId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <field name="prepareServiceName" type="text-medium"><description>Implements ai.rules.RuleLineServices.prepare#RuleLine.</description></field>
    </entity>

    <entity entity-name="RuleSetCondition" package="moqui.ai" use="configuration">
        <description>One "when" line of a rule.</description>
        <field name="ruleId" type="id" is-pk="true"/>
        <field name="conditionSeqId" type="id" is-pk="true"/>
        <field name="parentConditionSeqId" type="id" enable-audit-log="true"/>
        <field name="sequenceNum" type="number-integer" enable-audit-log="true"/>
        <field name="conditionTypeId" type="id" enable-audit-log="true"/>
        <field name="factTypeId" type="id" enable-audit-log="true"/>
        <field name="fieldName" type="id" enable-audit-log="true"/>
        <field name="operatorEnumId" type="id" enable-audit-log="true"/>
        <field name="compareValue" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="moqui.ai.RuleSetRule"/>
        <relationship type="one" title="Parent" related="moqui.ai.RuleSetCondition" short-alias="parent">
            <key-map field-name="ruleId"/><key-map field-name="parentConditionSeqId" related="conditionSeqId"/></relationship>
        <relationship type="one" related="moqui.ai.FactField" short-alias="field">
            <key-map field-name="factTypeId"/><key-map field-name="fieldName"/></relationship>
        <relationship type="one" related="moqui.ai.RuleConditionType" short-alias="conditionType"/>
        <relationship type="one" title="ComparisonOperator" related="moqui.basic.Enumeration" short-alias="operator">
            <key-map field-name="operatorEnumId" related="enumId"/></relationship>
    </entity>
    <view-entity entity-name="RuleSetConditionAndRule" package="moqui.ai">
        <description>Each rule line with the name of its rule, to find every rule that compares a field.</description>
        <member-entity entity-alias="RSC" entity-name="moqui.ai.RuleSetCondition"/>
        <member-entity entity-alias="RSR" entity-name="moqui.ai.RuleSetRule" join-from-alias="RSC">
            <key-map field-name="ruleId"/></member-entity>
        <alias-all entity-alias="RSC"/>
        <alias name="ruleName" entity-alias="RSR"/>
    </view-entity>

    <entity entity-name="RuleActionType" package="moqui.ai" use="configuration" cache="true">
        <description>One kind of "then" part, like return an outcome or add a fact, with the service that checks an action of
            this kind and gives what the decision needs from it.</description>
        <field name="actionTypeId" type="id" is-pk="true"/>
        <field name="description" type="text-medium"/>
        <field name="prepareServiceName" type="text-medium"><description>Implements ai.rules.RuleActionServices.prepare#RuleAction.</description></field>
    </entity>

    <entity entity-name="RuleSetAction" package="moqui.ai" use="configuration">
        <description>The "then" part of a rule: return an outcome, or add a new fact.</description>
        <field name="ruleId" type="id" is-pk="true"/>
        <field name="actionSeqId" type="id" is-pk="true"/>
        <field name="ruleSetId" type="id" enable-audit-log="true"/>
        <field name="actionTypeId" type="id" enable-audit-log="true"/>
        <field name="outcomeId" type="id" enable-audit-log="true"/>
        <field name="factTypeId" type="id" enable-audit-log="true"><description>The fact type an add fact action creates.</description></field>
        <relationship type="one" related="moqui.ai.RuleSetRule"/>
        <relationship type="one" related="moqui.ai.RuleSetOutcome" short-alias="outcome">
            <key-map field-name="ruleSetId"/><key-map field-name="outcomeId"/></relationship>
        <relationship type="one" related="moqui.ai.FactType"/>
        <relationship type="one" related="moqui.ai.RuleActionType" short-alias="actionType"/>
        <relationship type="many" related="moqui.ai.RuleSetActionField" short-alias="fields">
            <key-map field-name="ruleId"/><key-map field-name="actionSeqId"/></relationship>
    </entity>

    <entity entity-name="RuleSetActionField" package="moqui.ai" use="configuration">
        <description>One value of the new fact an action adds.</description>
        <field name="ruleId" type="id" is-pk="true"/>
        <field name="actionSeqId" type="id" is-pk="true"/>
        <field name="fieldName" type="id" is-pk="true"/>
        <field name="fixedValue" type="text-medium" enable-audit-log="true"/>
        <relationship type="one" related="moqui.ai.RuleSetAction">
            <key-map field-name="ruleId"/><key-map field-name="actionSeqId"/></relationship>
    </entity>
    <entity entity-name="FileCheck" package="moqui.ai" use="transactional">
        <description>One check of a file against a decision, kept so the Rule Author can review or download its outcomes.</description>
        <field name="fileCheckId" type="id" is-pk="true"/>
        <field name="ruleSetId" type="id"/>
        <field name="factTypeId" type="id"><description>The kind of file.</description></field>
        <field name="fileName" type="text-medium"/>
        <field name="checkedDate" type="date-time"/>
        <field name="checkedByUserId" type="id"/>
        <field name="recordCount" type="number-integer"/>
        <field name="refusedCount" type="number-integer"/>
        <relationship type="one" related="moqui.ai.RuleSet"/>
        <relationship type="one" related="moqui.ai.FactType"/>
        <relationship type="one" title="CheckedBy" related="moqui.security.UserAccount" short-alias="checkedBy">
            <key-map field-name="checkedByUserId" related="userId"/></relationship>
        <relationship type="many" related="moqui.ai.FileCheckRecord" short-alias="records"><key-map field-name="fileCheckId"/></relationship>
    </entity>

    <entity entity-name="FileCheckRecord" package="moqui.ai" use="transactional">
        <description>One record of a checked file, with its outcomes or the reasons it was refused.</description>
        <field name="fileCheckId" type="id" is-pk="true"/>
        <field name="recordNumber" type="number-integer" is-pk="true"/>
        <field name="recordValues" type="text-very-long"><description>The record's values as a JSON object.</description></field>
        <field name="outcomes" type="text-medium"><description>The outcome ids as a JSON list. Empty when the record was refused.</description></field>
        <field name="refusedReasons" type="text-very-long"><description>Why the record was refused, as a JSON list.</description></field>
        <relationship type="one" related="moqui.ai.FileCheck"/>
    </entity>
</entities>
