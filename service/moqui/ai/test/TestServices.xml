<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">
    <service verb="get" noun="Echo">
        <in-parameters>
            <parameter name="text" type="String" required="true"><description>Text to echo back.</description></parameter>
            <parameter name="repeat" type="Integer"/>
        </in-parameters>
        <out-parameters><parameter name="echoed" type="String"/></out-parameters>
        <actions>
            <if condition="repeat != null &amp;&amp; repeat &lt; 0"><return error="true" message="repeat must be >= 0"/></if>
            <set field="echoed" value="${text}"/>
            <if condition="repeat"><set field="echoed" value="${echoed * repeat}"/></if>
        </actions>
    </service>

    <!-- A no-op write-verb service so store#AiTool can derive effect=MUTATING from the verb. -->
    <service verb="update" noun="Noop">
        <in-parameters><parameter name="noopId" type="String"/></in-parameters>
        <out-parameters><parameter name="noopId" type="String"/></out-parameters>
        <actions><set field="noopId" from="noopId"/></actions>
    </service>

    <!-- A write-verb echo: a deterministic MUTATING tool fixture for Composer preview tests. The verb
         "set" makes store#AiTool derive effect=MUTATING. Body is a harmless echo (no real write). -->
    <service verb="set" noun="Echo">
        <in-parameters>
            <parameter name="text" type="String" required="true"><description>Text to echo back.</description></parameter>
            <parameter name="repeat" type="Integer"/>
        </in-parameters>
        <out-parameters><parameter name="echoed" type="String"/></out-parameters>
        <actions>
            <if condition="repeat != null &amp;&amp; repeat &lt; 0"><return error="true" message="repeat must be >= 0"/></if>
            <set field="echoed" value="${text}"/>
            <if condition="repeat"><set field="echoed" value="${echoed * repeat}"/></if>
        </actions>
    </service>

    <!-- Identical to get#Echo; a distinct serviceName so it can be registered as an approval-gated
         tool (seeded via AiTestToolData.xml) without colliding with the ungated get#Echo entry. -->
    <service verb="get" noun="GatedEcho">
        <in-parameters>
            <parameter name="text" type="String" required="true"><description>Text to echo back.</description></parameter>
            <parameter name="repeat" type="Integer"/>
        </in-parameters>
        <out-parameters><parameter name="echoed" type="String"/></out-parameters>
        <actions>
            <if condition="repeat != null &amp;&amp; repeat &lt; 0"><return error="true" message="repeat must be >= 0"/></if>
            <set field="echoed" value="${text}"/>
            <if condition="repeat"><set field="echoed" value="${echoed * repeat}"/></if>
        </actions>
    </service>

    <!-- A credential-shaped echo for the audit-redaction tests: takes a secret-named argument and
         hands it back under secret-named result keys, at the top level and nested in a Map and a List,
         next to plain fields that must survive. The caller gets the real values back; the AiToolCall
         row must carry the redaction marker in their place. -->
    <service verb="get" noun="CredentialEcho">
        <in-parameters>
            <parameter name="text" type="String" required="true"><description>Text to echo back.</description></parameter>
            <parameter name="clientSecret" type="String"><description>A credential-shaped argument, handed back in the result.</description></parameter>
        </in-parameters>
        <out-parameters>
            <parameter name="echoed" type="String"/>
            <parameter name="accessToken" type="String"/>
            <parameter name="connection" type="Map"/>
        </out-parameters>
        <actions>
            <set field="echoed" from="text"/>
            <set field="accessToken" from="clientSecret"/>
            <set field="connection" from="[host: 'queue.example.test', secretAccessKey: clientSecret,
                    queues: [[name: 'orders', apiKey: clientSecret]]]"/>
        </actions>
    </service>
</services>
