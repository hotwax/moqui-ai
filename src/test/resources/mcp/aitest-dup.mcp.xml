     xsi:noNamespaceSchemaLocation="../../../../xsd/mcp-api-1.xsd"
     name="aitest2" version="1.0.0" description="Duplicate-name fixture.">
    <tool name="echo_text" description="Colliding declaration of echo_text.">
        <service name="moqui.ai.test.TestServices.get#Echo"/>
    </tool>
</mcp>
