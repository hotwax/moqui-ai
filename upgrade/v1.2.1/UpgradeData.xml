<?xml version="1.0" encoding="UTF-8"?>
<entity-facade-xml type="ext-upgrade">
    <!-- MCP dispatch grant, from data/SetupData.xml (ext-seed). The upgrade runner only loads this
         file, so an instance upgraded without a manual ext-seed load had no grant and every
         authenticated MCP tool call failed with "not authorized for this tool". -->
    <moqui.security.ArtifactGroup artifactGroupId="MCP_DISPATCH" description="MCP endpoint dispatch service (rate limiting)"/>
    <moqui.security.ArtifactGroupMember artifactGroupId="MCP_DISPATCH" artifactTypeEnumId="AT_SERVICE"
                                        artifactName="ai.mcp.McpServices.dispatch#Request" nameIsPattern="N" inheritAuthz="Y"/>
    <moqui.security.ArtifactAuthz artifactAuthzId="McpServicesADMIN" userGroupId="ADMIN" artifactGroupId="MCP_DISPATCH" authzTypeEnumId="AUTHZT_ALWAYS" authzActionEnumId="AUTHZA_ALL"/>

    <!-- Tool-call audit source and the non-overridable tool denylist, from data/AiStatusData.xml
         (ext-seed). AiToolCall.sourceEnumId has a foreign key to these enumerations, so without them
         an MCP call's audit row cannot be written. Without the denylist rows nothing vetoes a
         delete#, org.moqui.impl, password, UserAccount or ArtifactAuthz service at tool scan. -->
    <moqui.basic.EnumerationType description="AI Tool Call Source" enumTypeId="AiToolCallSource"/>
    <moqui.basic.Enumeration description="Agent run" enumId="AI_TCS_AGENT" enumTypeId="AiToolCallSource"/>
    <moqui.basic.Enumeration description="MCP client" enumId="AI_TCS_MCP" enumTypeId="AiToolCallSource"/>

    <moqui.ai.AiToolDenylist servicePattern=".*\.delete#.*"          reason="Deletes must not be AI-exposable"/>
    <moqui.ai.AiToolDenylist servicePattern="org\.moqui\.impl\..*"    reason="Framework-internal services"/>
    <moqui.ai.AiToolDenylist servicePattern=".*[Pp]assword.*"         reason="Credential/security services"/>
    <moqui.ai.AiToolDenylist servicePattern=".*UserAccount.*"         reason="User/account administration"/>
    <moqui.ai.AiToolDenylist servicePattern=".*ArtifactAuthz.*"       reason="Authorization administration"/>
</entity-facade-xml>
